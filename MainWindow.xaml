<Window x:Class="PulseForgeStudio.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PulseForge Studio" Width="1500" Height="900" MinWidth="1100" MinHeight="700"
 WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Menu DockPanel.Dock="Top" Background="#171D27" Foreground="#E9EDF5">
   <MenuItem Header="_File"><MenuItem Header="_New" Click="New_Click"/><MenuItem Header="_Open…" Click="Open_Click"/><MenuItem Header="_Save…" Click="Save_Click"/><Separator/><MenuItem Header="Export _WAV…" Click="Export_Click"/><Separator/><MenuItem Header="E_xit" Click="Exit_Click"/></MenuItem>
   <MenuItem Header="_Edit"><MenuItem Header="Clear pattern" Click="Clear_Click"/><MenuItem Header="Load demo" Click="Demo_Click"/></MenuItem>
   <MenuItem Header="_View"/><MenuItem Header="_Transport"><MenuItem Header="Play/Stop (Space)" Click="Play_Click"/></MenuItem>
   <MenuItem Header="_Help"><MenuItem Header="About PulseForge" Click="About_Click"/></MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" Height="64" Background="#1A202B" BorderBrush="#323C4B" BorderThickness="0,0,0,1">
   <Grid Margin="12,7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="▮▮▮  PulseForge Studio" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#C9B4FF" Margin="0,0,24,0"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="PlayButton" Content="▶  PLAY" Click="Play_Click" Foreground="#52E3B2"/><Button Content="■  STOP" Click="Stop_Click"/><Button Content="●  REC" Foreground="#FF6475" Click="Record_Click"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0"><TextBlock Text="BPM" VerticalAlignment="Center" Foreground="#8F99AA"/><TextBox x:Name="BpmBox" Text="128" Width="55" Margin="7,0" VerticalContentAlignment="Center" LostFocus="Bpm_Changed"/></StackPanel>
    <TextBlock Grid.Column="3" x:Name="ProjectTitle" Text="Untitled Project" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="4" Orientation="Horizontal"><TextBlock x:Name="TimeText" Text="00:00.000" VerticalAlignment="Center" FontFamily="Consolas" FontSize="16"/><Border Width="170" Height="8" Background="#10151C" CornerRadius="4" Margin="14,0"><Border x:Name="ProgressBar" Width="0" HorizontalAlignment="Left" Background="#34D7D5" CornerRadius="4"/></Border></StackPanel>
   </Grid>
  </Border>
  <StatusBar DockPanel.Dock="Bottom" Background="#171D27" Foreground="#8F99AA"><StatusBarItem Content="Ready" x:Name="StatusText"/><Separator/><StatusBarItem Content="Audio engine: 44.1 kHz · 16-bit stereo"/><Separator/><StatusBarItem Content="Native Windows · PulseForge 1.0"/></StatusBar>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#151B24" BorderBrush="#323C4B" BorderThickness="0,0,1,0"><DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Browser" FontSize="16" FontWeight="SemiBold" Margin="14"/>
    <TextBox DockPanel.Dock="Top" Text="Search instruments…" Foreground="#8F99AA" Margin="10"/>
    <TreeView Background="Transparent" Foreground="#D7DCE6" BorderThickness="0" Margin="7">
     <TreeViewItem Header="▾ Instruments" IsExpanded="True"><TreeViewItem Header="◈ PulseForge Drums"/><TreeViewItem Header="◈ Analog Kit"/><TreeViewItem Header="◈ Urban Kit"/></TreeViewItem>
     <TreeViewItem Header="▸ Bass"/><TreeViewItem Header="▸ Synths"/><TreeViewItem Header="▸ Keys"/><TreeViewItem Header="▸ Pads"/><TreeViewItem Header="▸ Vocals"/><TreeViewItem Header="▸ FX"/>
    </TreeView>
   </DockPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Margin="8,8,4,4" Background="#181F29" BorderBrush="#323C4B" BorderThickness="1" CornerRadius="3"><DockPanel>
     <Grid DockPanel.Dock="Top" Height="38" Background="#222A37"><TextBlock Text="Arrangement · Step Sequencer" FontSize="15" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/><TextBlock Text="1       2       3       4" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="#8F99AA"/></Grid>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SequencerPanel" Margin="8"/></ScrollViewer>
    </DockPanel></Border>
    <Border Grid.Row="1" Margin="8,4,4,8" Background="#181F29" BorderBrush="#323C4B" BorderThickness="1" CornerRadius="3"><DockPanel>
     <Grid DockPanel.Dock="Top" Height="38" Background="#222A37"><TextBlock Text="Piano Roll · Lead" FontSize="15" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/><TextBlock Text="Click cells to add/remove notes" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#8F99AA"/></Grid>
     <Canvas x:Name="PianoCanvas" Background="#121821" MouseLeftButtonDown="Piano_Click" SizeChanged="Piano_SizeChanged"/>
    </DockPanel></Border>
   </Grid>
   <Border Grid.Column="2" Margin="4,8,8,8" Background="#181F29" BorderBrush="#323C4B" BorderThickness="1" CornerRadius="3"><DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Mixer" FontSize="16" FontWeight="SemiBold" Background="#222A37" Padding="12,10"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MixerPanel" Margin="8"/></ScrollViewer>
   </DockPanel></Border>
  </Grid>
 </DockPanel>
</Window>
