<Application x:Class="PulseForgeStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#11151D"/>
    <SolidColorBrush x:Key="Panel" Color="#1A202B"/>
    <SolidColorBrush x:Key="Panel2" Color="#222A37"/>
    <SolidColorBrush x:Key="Border" Color="#323C4B"/>
    <SolidColorBrush x:Key="Text" Color="#E9EDF5"/>
    <SolidColorBrush x:Key="Muted" Color="#8F99AA"/>
    <SolidColorBrush x:Key="Accent" Color="#9B6CFF"/>
    <SolidColorBrush x:Key="Cyan" Color="#34D7D5"/>
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Bg}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#39445A"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#111720"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="7,4"/></Style>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Style>
  </Application.Resources>
</Application>
